<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2">
<body>
    <h3>Listing.title: </h3>
    </div>
    <div class="card col-md-6 offset-md-2">
        <img src="<%= listing.imageUrl %>" alt="listing image" class = "card-img-top show-img">
        <div class="card-body"></div>
        <p class="card-text">
        <b><%= listing.title %></b> <br>
        <%= listing.description %><br>
        &#8377;<%= listing.price.toLocaleString("en-IN") %> / night <br> 
        <%= listing.location %><br>
        <%= listing.country %><br> 
        
        </p>
    </div>
    
</body>
<div class="card-body">
    <a href="/listings/<%=listing._id %>/edit" class="btn btn-dark btn-sm col-1 offset-2">Edit</a>
    <form action="/listings/<%=listing._id %>?_method=DELETE" method="POST" class="d-inline">
        <button class="btn btn-danger btn-sm col-1 ms-2">Delete</button>
    </form>
</div>
</div>