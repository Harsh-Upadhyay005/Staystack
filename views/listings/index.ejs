<% layout("/layouts/boilerplate") %>
<body>
  <h2>All Listings</h2>
  <!-- <form action="/listings/new" method="GET">
        <button>Create New Listing</button>
    </form> -->

  <div class="row row-cols-lg-6 row-cols-md-4 row-cols-sm-2 row-cols-1 g-4">
    <% listings.forEach(function(listing) { %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
             <div class="card col">
      <img
        src="<%= listing.imageUrl %>"
        class="card-img-top"
        alt="listing_image"
        style = "height: 10rem; object-fit: cover; border-radius: 2rem;"
      />
      <div class="card-img-overlay"> <b>&#9825;</b></div>
      <div class="card-body">
        <h5 class="card-title"></h5>
        <p class="card-text">
          <b><%= listing.title %></b> <br />
          ₹<%= listing.price.toLocaleString("en-IN") %>/night
        </p>
      </div>
    </div>
    <% }); %>
    </a>
  </div>

        
   
</body>
