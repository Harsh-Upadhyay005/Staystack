<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-md-8 offset-md-2">
  <h2>Edit Listing</h2>
  <form action="/listings/<%= listing._id %>?_method=PUT" method="POST">
    <div class="mb-3">
      <label for="title">Title:</label>
      <input
        type="text"
        value="<%= listing.title %>"
        id="title"
        name="listing[title]"
        class="form-control"
        required
      />
    </div>

    <div class="mb-3">
      <label for="description">Description:</label>
      <textarea id="description" name="listing[description]" class="form-control" required>
<%= listing.description %></textarea
      >
    </div>

    
    <div class="mb-3">
        <label for="imageUrl">Image URL:</label>
        <input
        type="text"
        value="<%= listing.imageUrl %>"
        id="imageUrl"
        name="listing[imageUrl]"
        class="form-control"
        /><br />
        <br />
    </div>
    
    <div class="row">
        
        <div class="mb-3 col-md-4">
            <label for="price">Price:</label>
            <input
            type="number"
            value="<%= listing.price %>"
            id="price"
            name="listing[price]"
            class="form-control"
            required
            /><br />
            <br />
        </div>
        <div class="mb-3 col-md-6">
            <label for="country">Country:</label>
            <input
            type="text"
            value="<%= listing.country %>"
            id="country"
            name="listing[country]"
            class="form-control"
            required
            /><br />
        </div>
    </div>
    
    <div class="mb-3">
      <label for="location">Location:</label>
      <input
        type="text"
        value="<%= listing.location %>"
        id="location"
        name="listing[location]"
            class="form-control"
        required
      />
      <br />
    </div>
    
    

    <button class="btn btn-primary edit-btn">Edit Listing</button>
    <br> <br>
  </form>
    </div>
</div>
